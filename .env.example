# =====================================================================
# EvalTIC — configuración para Docker (la lee docker compose y la app)
# =====================================================================

# --- Qué contenedores levantar ---------------------------------------
# "ollama" levanta también el LLM local dentro de Docker.
# Si usan una API remota (Groq, OpenAI...) o Ollama instalado en Windows, dejarlo vacío.
COMPOSE_PROFILES=ollama

# --- LLM --------------------------------------------------------------
# Proveedor: "ollama" (local) u "openai" (cualquier API compatible: OpenAI, Groq, OpenRouter)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b
# URL de Ollama vista desde el contenedor de la app:
#   - Ollama en Docker (perfil "ollama"):   http://ollama:11434/api/generate
#   - Ollama instalado en Windows:          http://host.docker.internal:11434/api/generate
OLLAMA_URL_DOCKER=http://ollama:11434/api/generate

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Neo4j local (contenedor neo4j-evaltic) ---------------------------
NEO4J_PASSWORD=evaltic2026
NEO4J_LOCAL_USERNAME=neo4j
NEO4J_LOCAL_DATABASE=neo4j

# Poner en 1 para borrar y volver a cargar el grafo del PG2 en el próximo "up"
RECARGAR=0
